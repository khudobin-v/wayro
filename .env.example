# Vercel Postgres (Neon) — берётся автоматически при подключении БД в Vercel
DATABASE_URL="postgresql://..."
# Для Prisma migrations (non-pooling)
DIRECT_URL="postgresql://..."

# JWT — любая длинная случайная строка (openssl rand -base64 32)
JWT_SECRET="your-secret-here"

# URL приложения
NEXT_PUBLIC_APP_URL="http://localhost:3000"
